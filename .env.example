# -----------------------------------------------------------------------------
# 5G Remote Hands - Production & Deployment Environment Configuration
# -----------------------------------------------------------------------------

# --- Server Runtime Settings ---
# Host interface to bind (0.0.0.0 binds to all 5G UPF / MEC / LAN interfaces)
SERVER_HOST=0.0.0.0

# Production HTTPS / WSS port (WebXR on Meta Quest requires HTTPS)
SERVER_PORT=8443

# Plain HTTP port (optional, desktop browser debugging only; leave empty for HTTPS)
# HTTP_PORT=8080

# Default simulation scenario: flood | earthquake | wildfire | landslide | arm
SCENARIO=flood

# Auto-generate self-signed TLS cert on startup if certs/cert.pem is missing
AUTO_GEN_CERT=true

# --- 5G Network & Certificate Settings ---
# Primary 5G MEC Server IP (included in Subject Alternative Names (SAN) of SSL cert)
SERVER_IP=127.0.0.1

# Extra IPs or DNS hostnames to include in the TLS certificate (comma or space separated)
# Example: 192.168.1.184, 10.45.0.1, mec.5g-lab.local
EXTRA_IPS=localhost

# Custom certificate and logging paths (defaults to ./certs and ./logs)
CERT_DIR=./certs
LOG_DIR=./logs

# --- Automated Remote Deployment Settings (deploy.sh) ---
# Target 5G Server Hostname or IP
DEPLOY_SERVER_IP=

# Target SSH Username
DEPLOY_SSH_USER=ubuntu

# Target SSH Port (default: 22)
DEPLOY_SSH_PORT=22

# Remote destination directory on target server
DEPLOY_PATH=/opt/5g-remote-hands

# Deployment Mode: 'docker' (recommended) or 'bare-metal' (systemd)
DEPLOY_MODE=docker

# Docker Network Mode: 'bridge' (port-mapped 8443:8443) or 'host' (direct N6 interface for ultra-low latency)
DOCKER_NETWORK_MODE=bridge

